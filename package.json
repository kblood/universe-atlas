{
  "name": "universe-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npm run prepare:creature-kit && npm run prepare:flora-kit",
    "prepare:creature-kit": "node scripts/sync-creature-kit.mjs --write --kit external/creature-kit",
    "update:creature-kit": "git submodule update --init --remote external/creature-kit && npm run prepare:creature-kit",
    "check:creature-kit": "node scripts/sync-creature-kit.mjs --kit external/creature-kit",
    "predev": "npm run prepare",
    "dev": "vite --host 127.0.0.1 --port 5186",
    "prebuild": "npm run prepare",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run prepare",
    "preview": "vite preview --host 127.0.0.1 --port 5186",
    "test": "node tests/helpers/test-slot.mjs --shared 16 -- node --test --test-concurrency=16 --test-isolation=process --require ./tests/helpers/default-test-suite.cjs",
    "test:pkg": "node tests/helpers/test-runner.mjs pkg",
    "test:affected": "node tests/helpers/test-runner.mjs affected",
    "test:full": "node tests/helpers/test-runner.mjs full",
    "test:full:legacy": "node tests/helpers/test-runner.mjs full-legacy",
    "test:all": "node tests/helpers/test-runner.mjs tier all",
    "test:perf": "node tests/helpers/test-runner.mjs perf",
    "test:smoke": "node tests/helpers/test-runner.mjs tier smoke",
    "test:work": "node tests/helpers/test-runner.mjs tier work",
    "test:fast": "node tests/helpers/test-runner.mjs fast",
    "test:life-guard": "node tests/helpers/life-guard.mjs",
    "test:fast:generate": "node tests/helpers/smoke-generate.mjs",
    "tier-sets:generate": "node scripts/tier-sets/generate.mjs",
    "tier-estimates": "node tests/helpers/test-runner.mjs tier-estimates",
    "test:golden": "node tests/golden/run-cross-engine.mjs",
    "test:shore": "node tests/shore-stability.mjs",
    "test:streaming": "node --test tests/terrain-streaming.mjs",
    "test:drainage": "node tests/drainage.mjs",
    "test:atmosphere": "node tests/atmospheric-flight.mjs",
    "test:clouds": "node tests/cloud-comparison.browser.mjs",
    "test:clouds:xr": "node tests/cloud-xr-smoke.browser.mjs",
    "test:fauna-corpus": "node tests/fauna-variation-corpus.browser.mjs",
    "test:fauna-skin": "node tests/fauna-skin-lab.browser.mjs",
    "test:fauna-closeup": "node tests/fauna-closeup.browser.mjs",
    "test:population-flight": "node tests/population-flight-integration.browser.mjs",
    "test:walking": "node tests/walking.mjs",
    "test:surface": "node tests/surface.mjs",
    "test:render-bounds-evidence": "node --test tests/render-bounds-evidence.test.mjs",
    "test:planet": "node tests/planet.mjs",
    "test:exploration": "node tests/exploration.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:vr": "node tests/vr.mjs",
    "test:continuous": "node tests/continuous.mjs",
    "test:travel": "node tests/travel.mjs",
    "test:rivers": "node tests/rivers.mjs",
    "test:biomes": "node tests/biome-lab.mjs",
    "test:biosphere": "node tests/biosphere-lab.mjs",
    "test:creatures": "node tests/creature-lab.mjs",
    "test:coat-allocation": "node tests/helpers/test-slot.mjs -- node --expose-gc tests/fauna-coat-allocation.bench.mjs",
    "prepare:flora-kit": "node scripts/check-flora-kit.mjs --prepare",
    "update:flora-kit": "git submodule update --init --remote external/flora-kit && npm run prepare:flora-kit",
    "check:flora-kit": "node scripts/check-flora-kit.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "polygon-clipping": "0.15.7",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@types/three": "0.181.0",
    "iwer": "2.4.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "imports": {
    "#creature-kit/planet": {
      "types": "./vendor/creature-kit/package/dist/planet-v1/index.d.ts",
      "default": "./vendor/creature-kit/package/dist/planet-v1/index.js"
    },
    "#flora-kit/v1/field": "./external/flora-kit/src/flora-field.ts",
    "#flora-kit/v1/culling": "./external/flora-kit/src/flora-culling.ts",
    "#tree-kit/v1/assets": "./src/tree-kit-v1/assets.ts",
    "#tree-kit/v1/instances": "./src/tree-kit-v1/instances.ts",
    "#tree-kit/v1/impostors": "./src/tree-kit-v1/impostors.ts",
    "#tree-kit/v1/metrics": "./src/tree-kit-v1/metrics.ts",
    "#tree-kit/v1/recipes": "./src/tree-kit-v1/recipes.ts",
    "#tree-kit/v1/presentation": "./src/tree-kit-v1/presentation.ts"
  }
}
