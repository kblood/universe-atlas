const args=process.argv.slice(2),validate=args.includes('--validate'),only=args.filter(a=>!a.startsWith('--'));
const est=name=>name.startsWith('box')?EST.box(Number(name.slice(3))):EST[name];
const lv=(m,levels)=>Object.fromEntries([5,6,7,8,9].map(L=>[L,levels.includes(L)?m:'point']));
const CONFIGS={
  point:lv('point',[]),
  corner_L67:lv('corner',[6,7]),           // retained draft (corner K=2, L<=7 at these levels)
  corner_L678:lv('corner',[6,7,8]),
  corner_L5to9:lv('corner',[5,6,7,8,9]),
  corner_L6:lv('corner',[6]),
  corner_L56:lv('corner',[5,6]),
  corner_L567:lv('corner',[5,6,7]),
  box2_L67:lv('box2',[6,7]),
  box2_L5to9:lv('box2',[5,6,7,8,9]),
  box4_L678:lv('box4',[6,7,8]),
  box8_L67:lv('box8',[6,7]),
  box8_L678:lv('box8',[6,7,8]),
  box8_L5to9:lv('box8',[5,6,7,8,9]),
  tent3_L678:lv('tent3',[6,7,8]),
  bspl_L678:lv('bspl',[6,7,8]),
  box2_L6:lv('box2',[6]),
  box8_L6:lv('box8',[6]),
};
const names=only.length?only:Object.keys(CONFIGS);
for(const [wname,w] of Object.entries(worlds)){
  if(validate){let bad=0,n=0;for(const d of w.dirs.slice(0,3))for(const L of [5,6,7,8,9]){const t=tiles.directionTile(d,L),b=tiles.buildTile(w.body,t).color,e=EST.point((u,v)=>w.colourOf(tiles.tileDirection(t,u,v)),128);n+=b.length;for(let i=0;i<b.length;i++)if(b[i]!==e[i])bad++;}
    console.log(wname,'point vs buildTile byte mismatches',bad,'of',n);}
  for(const cname of names){const cfg=CONFIGS[cname];const t0=performance.now();
    const texCache=new Map(),tex=t=>{const k=tiles.tileKey(t);if(!texCache.has(k))texCache.set(k,est(cfg[t.level])((u,v)=>w.colourOf(tiles.tileDirection(t,u,v)),128));return texCache.get(k);};
    const res=[];for(const L of [5,6,7,8]){const all=[];for(const d of w.dirs){const P=tiles.directionTile(d,L),C=tiles.directionTile(d,L+1);all.push(...metric(tex(P),tex(C),P,C));}res.push(quantile(all,.99).toFixed(3));}
    console.log(wname.padEnd(9),cname.padEnd(14),res.join(' / '),((performance.now()-t0)/1000).toFixed(1)+'s');
  }
}

