// The point estimator is validated byte-for-byte against buildTile colour bytes (estimators-baseline.mjs --validate).
// ROOT = a point-sampling checkout (default C:/LLM/IWSDK/universe-atlas, main). Run from this folder: node <script>.mjs
import {pathToFileURL} from 'node:url';
const root=process.env.ROOT||'C:/LLM/IWSDK/universe-atlas';
const base=pathToFileURL(root+'/').href;
const [tiles,terrain,biomes,fixtures,catalog,report]=await Promise.all(['src/planet-tiles.ts','src/terrain.ts','src/surface-biomes.ts','tests/terrain-climate-fixtures.mjs','src/catalog.ts','scripts/lod-consistency-report.mjs'].map(p=>import(base+p)));
const {tileDirection,directionTile,regionalBankWeights}=tiles;
const quantile=(a,q)=>{const s=Float64Array.from(a).sort();return s[Math.floor(q*(s.length-1))];};
const palette=[[160,141,94],[72,91,52],[104,96,84],[220,229,232]];
const substrate=w=>palette[0].map((_,c)=>Math.floor(w.reduce((s,x,i)=>s+x*palette[i][c],0)));

export function makeWorld(body){
  const ts=terrain.terrainSampler(body),cls=biomes.biomeClassifier(body);
  const code=Number(catalog.hash64(body.seed+'/macro-v1')&0xffffffffn),lgF=body.radiusM/800;
  const LG=terrain.TERRAIN_LOCAL_GRAIN||{BASE:.88,AMPLITUDE:.24};const localGrain=d=>LG.BASE+catalog.noise(d[0]*lgF+13,d[1]*lgF+37,d[2]*lgF+19,code+74)*LG.AMPLITUDE;
  const colourOf=(d,mode)=>{const s=ts(d);
    let c=s.wet?substrate(regionalBankWeights(body,s,cls(d,s.groundHeightM,1).weights)):s.color.slice();
    if(mode==='noLG'&&!s.ocean&&!s.wet){const g=localGrain(d);c=c.map(v=>v/g);} // decomposition only
    return c;};
  return {ts,cls,colourOf,localGrain};
}
// Estimators: (at(u,v)->rgb, size) -> Uint8Array RGBA (size+2)^2, buildTile layout.
const pack=(size,f)=>{const w=size+2,out=new Uint8Array(w*w*4);for(let y=0;y<w;y++)for(let x=0;x<w;x++){const c=f(x,y),p=(y*w+x)*4;for(let i=0;i<3;i++)out[p+i]=Math.floor(Math.max(0,Math.min(255,c[i])));out[p+3]=255;}return out;};
const memoGrid=(at,size,step,off)=>{const cache=new Map();return (gx,gy)=>{const k=gx+','+gy;let v=cache.get(k);if(!v){v=at((gx*step+off)/size,(gy*step+off)/size);cache.set(k,v);}return v;};};
export const EST={
  point:(at,size)=>pack(size,(x,y)=>at((x-.5)/size,(y-.5)/size)),
  // separable tap kernel on a grid of spacing `step` texels; taps given as [offset(in steps), weight]
  taps:(taps,step=1)=>(at,size)=>{
    // offsets relative to texel centre (x-.5) in texels: o*step
    const sum=taps.reduce((s,t)=>s+t[1],0);
    const cache=new Map();const g=(u,v)=>{const k=u+','+v;let c=cache.get(k);if(!c){c=at(u,v);cache.set(k,c);}return c;};
    return pack(size,(x,y)=>{const acc=[0,0,0];for(const [oy,wy] of taps)for(const [ox,wx] of taps){const c=g((x-.5+ox*step)/size,(y-.5+oy*step)/size),w=wx*wy/(sum*sum);for(let i=0;i<3;i++)acc[i]+=w*c[i];}return acc;});
  },
  box:K=>(at,size)=>pack(size,(x,y)=>{const acc=[0,0,0];for(let j=0;j<K;j++)for(let i=0;i<K;i++){const c=at((x-.5+(i+.5)/K-.5)/size,(y-.5+(j+.5)/K-.5)/size);for(let k=0;k<3;k++)acc[k]+=c[k]/(K*K);}return acc;}),
};
EST.corner=EST.taps([[-.5,1],[.5,1]]);
EST.bspl=EST.taps([[-1.5,1],[-.5,3],[.5,3],[1.5,1]]);
EST.tent3=EST.taps([[-1,1],[0,2],[1,1]]);

export function metric(pTex,cTex,P,C){
  const tp=128,tc=128,pw=tp+2,cw=tc+2,ox=C.x-P.x*2,oy=C.y-P.y*2,out=[];
  const tex=(u,v,ch)=>{const gx=u*tp+.5,gy=v*tp+.5,x=Math.floor(gx),y=Math.floor(gy),a=gx-x,b=gy-y,at=(i,j)=>pTex[(j*pw+i)*4+ch];
    return at(x,y)*(1-a)*(1-b)+at(x+1,y)*a*(1-b)+at(x,y+1)*(1-a)*b+at(x+1,y+1)*a*b;};
  for(let y=1;y<=tc;y++)for(let x=1;x<=tc;x++){const u=(ox+(x-.5)/tc)/2,v=(oy+(y-.5)/tc)/2,idx=(y*cw+x)*4;
    out.push(Math.hypot(...[0,1,2].map(ch=>tex(u,v,ch)-cTex[idx+ch])));}
  return out;
}
