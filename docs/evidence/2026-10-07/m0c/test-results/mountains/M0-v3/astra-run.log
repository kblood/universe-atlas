}

function heightPowers(m,body,ts,dirs,L,cache){
  const N=nyquistWavelengthM(body.radiusM,L),step=tileEdgeM(body.radiusM,L)/128;
  const sums=Array.from({length:4},()=>({coarse:0,truth:0,error:0}));
  for(const d of dirs){
    const t=m.directionTile(d,L),data=cache.get(m.tileKey(t))||m.buildTile(body,t);
    const coarse=new Float64Array(129*129),truth=new Float64Array(129*129);
    for(let y=0;y<=128;y++)for(let x=0;x<=128;x++){
      const i=y*129+x;coarse[i]=storedBilinear(data.surfaceHeight,32,x/128,y/128);
      truth[i]=ts(m.tileDirection(t,x/128,y/128)).groundHeightM;
    }
    // All 129 rows and columns, first 128 samples (FFT excludes the duplicate endpoint).
    for(let axis=0;axis<2;axis++)for(let line=0;line<=128;line++){
      const c=[],t=[],e=[];for(let j=0;j<128;j++){const i=axis?j*129+line:line*129+j;c.push(coarse[i]);t.push(truth[i]);e.push(coarse[i]-truth[i]);}
      const powers={coarse:bandPowers(c,step),truth:bandPowers(t,step),error:bandPowers(e,step)};
      for(let b=0;b<4;b++)for(const key of ['coarse','truth','error'])sums[b][key]+=powers[key].octave(N*2**b,N*2**(b+1));
    }
  }
  return sums.map((s,b)=>({octave:[2**b,2**(b+1)],...s,retainedRms:Math.sqrt(s.coarse/s.truth),errorPower:s.error/s.truth}));
}

