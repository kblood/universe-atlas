    '  if (s >= 1) return 0;\r\n' +
    '  const t = Math.max(0, Math.min(1, (s - MASSIF_ENVELOPE.EDGE_FADE_START) / (1 - MASSIF_ENVELOPE.EDGE_FADE_START)));\r\n' +
    '  return envelopeBlendWeight(belt) * (1 - t * t * (3 - 2 * t));\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function maxEnvelopeM(tau: number, cls: EnvelopeClass): number {\r\n' +
    "  return cls === 'water'\r\n" +
    '    ? MASSIF_ENVELOPE.GAIN * tau * MASSIF_ENVELOPE.RIDGE_EQUIVALENT_WATER_M\r\n' +
    '    : MASSIF_ENVELOPE.GAIN * MASSIF_ENVELOPE.RIDGE_EQUIVALENT_DRY_M;\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function massifEnvelopeM(\r\n' +
    '  belt: number, axisDistanceM: number, halfWidthM: number, a0: number,\r\n' +
    '  landFactor: number, tau: number, cls: EnvelopeClass,\r\n' +
    '): number {\r\n' +
    '  if (a0 <= 0 || belt === 0 || halfWidthM < MASSIF_ENVELOPE.MIN_HALF_WIDTH_M) return 0;\r\n' +
    '  const s = Math.abs(axisDistanceM) / massifHalfWidthM(halfWidthM);\r\n' +
    '  if (s >= 1) return 0;\r\n' +
    '  const p = 1 - s * s;\r\n' +
    '  return maxEnvelopeM(tau, cls) * (p * p * p) * landFactor * envelopeBlendWeight(belt);\r\n' +
    '}\r\n' +
    '\r\n' +
    '// The MTN-6 composition; the exact-zero branch preserves even signed zero. Outside the massif (belt 0, a\r\n' +
    "// width-gated belt, or |axisDistance| >= the massif half-width) main's term is returned unchanged; inside,\r\n" +
    "// main's term fades out by massifBlendWeight and the envelope (plus, at assembly, the M3 carving of it) is\r\n" +
