+  if (a !== null && typeof a === 'object') {
+    assert.deepEqual(Object.keys(a), Object.keys(b), path);
+    for (const k of Object.keys(a)) identical(a[k], b[k], `${path}.${k}`);
+  } else assert.ok(Object.is(a, b), `${path}: ${a} != ${b}`);
+}
+
+function checkWorld(body) {
+  const layout = orogenLayout(body);
+  const levels = [undefined, 0, carvingFromLevel(body.radiusM)];
+  const samplers = levels.flatMap(lodLevel => [false, true].map(exposeFloor => {
+    const options = {mountains: true, lodLevel};
+    return {
+      dispatch: terrainSampler(body, undefined, undefined, false, 0, undefined, exposeFloor, options),
+      forced: terrainSamplerForceMountainCoreForTest(body, options, exposeFloor),
+      plain: terrainSampler(body, undefined, undefined, false, 0, undefined, exposeFloor, {mountains: false}),
+      changed: 0,
+    };
+  }));
+  const directions = Array.from({length: 2048}, (_, i) => fib(i, 2048));
+  const sites = axisSites(body, {count: 1});
