    '// and on width-gated belts.\r\n' +
    'export function massifBlendWeight(belt: number, axisDistanceM: number, halfWidthM: number): number {\r\n' +
    '  if (belt === 0 || halfWidthM < MASSIF_ENVELOPE.MIN_HALF_WIDTH_M) return 0;\r\n' +
