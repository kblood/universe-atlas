const TAU=Number(process.env.TAU||0);
const texFor=(w,t,kern)=>{if(TAU&&Math.PI/2*w.body.radiusM/2**t.level/128<TAU)kern=KERN.point;const size=128,W=size+2,out=new Uint8Array(W*W*4),sw=kern.reduce((s,k)=>s+k[2],0);
  for(let y=0;y<W;y++)for(let x=0;x<W;x++){const d=tiles.tileDirection(t,(x-.5)/size,(y-.5)/size),s=w.ts(d),c=w.colourOf(d),p=(y*W+x)*4;
    let f=1;if(!s.ocean&&!s.wet){const g=w.localGrain(d);let m=0;for(const [du,dv,k] of kern)m+=k*w.localGrain(tiles.tileDirection(t,(x-.5+du)/size,(y-.5+dv)/size));f=m/sw/g;}
    for(let i=0;i<3;i++)out[p+i]=Math.floor(Math.max(0,Math.min(255,c[i]*f)));out[p+3]=255;}
  return out;};
const names=process.argv.slice(2).length?process.argv.slice(2):Object.keys(KERN);
