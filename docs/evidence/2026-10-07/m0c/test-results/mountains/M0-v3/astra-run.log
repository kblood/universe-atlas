const sep=(o)=>{const t=[];for(const [dy,wy] of o)for(const [dx,wx] of o)t.push([dx,dy,wx*wy]);return t;};
const KERN={point:[[0,0,1]],box2:box(2),box4:box(4),tentH:sep([[-.5,1],[0,2],[.5,1]]),bsplH:sep([[-.75,1],[-.25,3],[.25,3],[.75,1]]),
