// Stored-grid interpolation includes the exact last row/column at u or v = 1.
function storedBilinear(grid,n,u,v){
  const gx=u*n,gy=v*n,x=Math.min(n-1,Math.floor(gx)),y=Math.min(n-1,Math.floor(gy)),a=gx-x,b=gy-y,s=n+1;
  return grid[y*s+x]*(1-a)*(1-b)+grid[y*s+x+1]*a*(1-b)+grid[(y+1)*s+x]*(1-a)*b+grid[(y+1)*s+x+1]*a*b;
}

/** Production texture and material bytes, not the sampler proxy used by crossPair. */
export function crossPairTile(m,body,ts,d,L,acc,cache=new Map()){
  const P=m.directionTile(d,L),C=m.directionTile(d,L+1),n=m.PATCH_SEGMENTS;
  const build=t=>{const key=m.tileKey(t);if(!cache.has(key))cache.set(key,m.buildTile(body,t));return cache.get(key);};
  const p=build(P),c=build(C),tp=p.width-2,tc=c.width-2,ox=C.x-P.x*2,oy=C.y-P.y*2,heat=[];
  const tex=(u,v,ch)=>{
    const gx=u*tp+.5,gy=v*tp+.5,x=Math.floor(gx),y=Math.floor(gy),a=gx-x,b=gy-y;
    const at=(i,j)=>p.color[(j*p.width+i)*4+ch];
    return at(x,y)*(1-a)*(1-b)+at(x+1,y)*a*(1-b)+at(x,y+1)*(1-a)*b+at(x+1,y+1)*a*b;
  };
  for(let y=1;y<=tc;y++)for(let x=1;x<=tc;x++){
    const u=(ox+(x-.5)/tc)/2,v=(oy+(y-.5)/tc)/2,idx=(y*c.width+x)*4;
    const delta=Math.hypot(...[0,1,2].map(ch=>tex(u,v,ch)-c.color[idx+ch]));acc.rgb.push(delta);heat.push(delta);
  }
  const snow=Array.from({length:(n+1)**2},(_,i)=>p.materials[i*4+3]/255);
  for(let y=0;y<=n;y++)for(let x=0;x<=n;x++){
    if(x%2===0&&y%2===0)continue;
    if(ts(m.tileDirection(C,x/n,y/n)).groundHeightM<0)continue;
    acc.land++;if((storedBilinear(snow,n,(ox+x/n)/2,(oy+y/n)/2)>.5)!==(c.materials[(y*(n+1)+x)*4+3]/255>.5))acc.snow++;
  }
